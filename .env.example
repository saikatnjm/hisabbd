# All optional. Set these in Vercel → Project → Settings → Environment Variables.

# Public base URL for canonical links. On Vercel it defaults to the production
# domain (e.g. https://hisabbd-five.vercel.app); set it only for a custom domain.
# NEXT_PUBLIC_SITE_URL=https://example.com

# Search engine ownership tags (only the token value from the meta tag's content="…").
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=

# Google Analytics 4 measurement id (G-XXXXXXXXXX). Off when unset.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Umami analytics (cookieless). Off when unset.
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
