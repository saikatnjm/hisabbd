+import { ContentSection } from "@/components/ui/content-section";
+
+/** Bangla explanatory content for the Profit and Loss Calculator page (Server Component, no JS). */
+export function ProfitLossCalculatorContentBn() {
+  return (
+    <>
+      <ContentSection id="how-it-works" title="লাভ-ক্ষতি যেভাবে হিসাব হয়">
+        <ul>
+          <li>
+            <strong>লাভ বা ক্ষতি = বিক্রয়মূল্য − ক্রয়মূল্য।</strong> ধনাত্মক হলে লাভ, ঋণাত্মক হলে
