+export function CgpaCalculatorContentBn() {
+  return (
+    <>
+      <ContentSection id="how-it-works" title="সিজিপিএ যেভাবে হিসাব হয়">
+        <p>
+          <strong>সিজিপিএ = Σ (সেমিস্টারের জিপিএ × সেমিস্টারের ক্রেডিট) ÷ Σ ক্রেডিট</strong>
+        </p>
+        <p>
+          প্রতিটি সেমিস্টার তার ক্রেডিটের অনুপাতে গোনা হয়। প্রতিটি সেমিস্টারের জিপিএ-কে তার ক্রেডিট
+          দিয়ে গুণ করুন, ফলগুলো যোগ করুন, তারপর মোট ক্রেডিট দিয়ে ভাগ করুন।
+        </p>
+
+        <h3>একটি উদাহরণ</h3>
+        <p>
+          সেমিস্টার ১: 12 ক্রেডিটে 3.50 দেয় 42.00। সেমিস্টার ২: 18 ক্রেডিটে 4.00 দেয় 72.00। মোট =
+          30 ক্রেডিটে 114.00, তাই সিজিপিএ = 114 ÷ 30 = <strong>3.80</strong>।
+        </p>
+      </ContentSection>
+
+      <ContentSection id="not-a-simple-average" title="শুধু জিপিএ-গুলোর গড় করলেই হয় না কেন?">
+        <p>
+          সাধারণ গড় প্রতিটি সেমিস্টারকে সমান ধরে — যা তখনই ঠিক, যখন সব সেমিস্টারের ক্রেডিট সমান। 9
+          ক্রেডিটে 3.80 আর 18 ক্রেডিটে 3.00 ধরুন:
+        </p>
+        <ul>
+          <li>সাধারণ গড়: (3.80 + 3.00) ÷ 2 = 3.40 (ভুল)</li>
+          <li>ওজনসহ: (3.80 × 9 + 3.00 × 18) ÷ 27 = 88.2 ÷ 27 = 3.27 (সঠিক)</li>
+        </ul>
+        <p>ভারী সেমিস্টারটি সিজিপিএ-কে নিজের জিপিএ-র দিকে টানে, তাই সঠিক উত্তর কম।</p>
+      </ContentSection>
+
+      <ContentSection id="add-a-semester" title="বর্তমান সিজিপিএ-র সাথে নতুন সেমিস্টার যোগ করা">
+        <p>
+          সব পুরোনো সেমিস্টার আলাদা করে লাগবে না। বর্তমান সিজিপিএ আর এ পর্যন্ত সম্পন্ন মোট ক্রেডিট
+          একটি সারিতে লিখুন, নতুন সেমিস্টারটি আরেক সারিতে। প্রতিটি সেমিস্টার আলাদা করে লিখলেও ঠিক একই
+          ফল আসত।
+        </p>
